FROM ghcr.io/astral-sh/uv:0.12.1 AS uv

FROM mirror.gcr.io/python:3.12-slim

# the build runs offline, so uv has to come from an image rather than an install
COPY --from=uv /uv /usr/local/bin/uv

# Test disabled network access
RUN if getent hosts www.google.com; then echo "Has network access!"; exit 1; fi

# During the build, the source code is only mounted, not copied.
# `uv sync` writes a virtualenv next to pyproject.toml, so it needs a real copy.
RUN cp -r /src /app
WORKDIR /app

RUN . /tmp/hermeto.env && uv sync --verbose
