{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    ":enableVulnerabilityAlerts",
    ":disableDependencyDashboard"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "enabledManagers": [
    "github-actions",
    "dockerfile",
    "pip_requirements"
  ],
  "registryAliases": {
    "mirror.gcr.io": "docker.io"
  },
  "packageRules": [
    {
      "description": "Weekly GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "extends": [
        "schedule:weekly"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Disable Python updates in GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    }
  ]
}
